[Desktop Entry]
Version=1.0
Type=X-XFCE-Helper
Name=Brave Origin
X-XFCE-Category=WebBrowser
# Same flags as the dock launcher: the container has no userns for the
# SUID sandbox, so bare launches die in chrome-sandbox (see TROUBLESHOOTING).
X-XFCE-Commands=/usr/bin/brave-origin-stable --test-type --no-sandbox --disable-dev-shm-usage --disable-gpu --no-first-run --password-store=basic
X-XFCE-CommandsWithParameter=/usr/bin/brave-origin-stable --test-type --no-sandbox --disable-dev-shm-usage --disable-gpu --no-first-run --password-store=basic "%s"
