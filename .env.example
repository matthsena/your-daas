# Local overrides (never commit .env itself)
TZ=
WEB_PORT=5174
NOVNC_PORT=6080
FILE_API_PORT=7071
AUDIO_PORT=7072

# Production only (docker-compose.prod.yml). Token from the Cloudflare
# Zero Trust dashboard when creating the tunnel. Keep in .env, never commit.
TUNNEL_TOKEN=

# R2 / S3-compatible backup target for deploy/r2-backup.sh
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Control plane (per-user desktops). All have working defaults.
CONTROL_PORT=8080
NET_NAME=your-daas_default
IDLE_MINUTES=30
SESSION_HOURS=24

# Optional per-user resource caps (quotas phase 1). Unset = uncapped.
#USER_MEM_LIMIT=4g
#USER_NANO_CPUS=2000000000
